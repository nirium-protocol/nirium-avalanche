{
  "name": "nirium-avalanche",
  "version": "0.2.0",
  "description": "Pay and charge with x402 on Avalanche, refuse a payment before it is signed, and keep a payer-signed receipt bound to the exact USDC transfer",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirium-protocol/nirium-avalanche.git",
    "directory": "avalanche"
  },
  "homepage": "https://github.com/nirium-protocol/nirium-avalanche#readme",
  "bugs": {
    "url": "https://github.com/nirium-protocol/nirium-avalanche/issues"
  },
  "keywords": [
    "x402",
    "avalanche",
    "usdc",
    "payments",
    "receipts",
    "ai-agents",
    "eip-3009",
    "erc-8004"
  ],
  "exports": {
    ".": "./sdk/index.mjs",
    "./policy": "./policy/evm-policy.mjs",
    "./policy/x402-fetch": "./policy/x402-fetch.mjs",
    "./policy/rules": "./policy/rules-policy.mjs",
    "./receipt": "./sdk/receipt.mjs",
    "./decision": "./sdk/decision.mjs",
    "./verify": "./verify-evm-core.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "nirium-verify-evm": "verify-evm-receipt.mjs"
  },
  "files": [
    "sdk/*.mjs",
    "policy/evm-policy.mjs",
    "policy/x402-fetch.mjs",
    "policy/rules-policy.mjs",
    "verify-evm-core.mjs",
    "verify-evm-receipt.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs policy/test/*.test.mjs sdk/test/*.test.mjs",
    "test:verify": "node --test test/*.test.mjs",
    "test:policy": "node --test policy/test/*.test.mjs",
    "test:sdk": "node --test sdk/test/*.test.mjs",
    "test:live": "bash run-tests.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "viem": "2.58.7",
    "@x402/core": "2.32.0",
    "@x402/evm": "2.32.0",
    "@x402/express": "2.32.0",
    "@x402/fetch": "2.32.0"
  },
  "peerDependencies": {
    "express": "^4.22.3 || ^5.3.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "5.3.0"
  }
}
